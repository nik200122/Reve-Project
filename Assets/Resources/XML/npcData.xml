<NPCs>
  <NPC id="npc_001">
    <Name>Elira</Name>
    <Backstory>Elira is the guardian of the Elenora forest, an expert in magic and ancient knowledge.</Backstory>
    <Personality>Wise, enigmatic, and protective. She doesn't trust strangers and you have to be really close to come to know about her secrets. </Personality>
    <InteractText>Talk</InteractText>
    <detectionRadius>10</detectionRadius>
    <detectionAngle>70</detectionAngle>
    <GiveableItems>
    <ConsumableItem>
      <tag>Potion02</tag>
      <name>Epic potion</name>
      <description>Good potion</description>
      <count>1</count>
      <modifiers>
        <StatModifier>
          <targetStat>Hp</targetStat>
          <value>30</value>
          <modifierType>Additive</modifierType>
        </StatModifier>
      </modifiers>
      <spritePath>PathToSprite</spritePath>
    </ConsumableItem>
  </GiveableItems>
    <TriggerActions>
      <TriggerAction>
        <Trigger>WarnOthers</Trigger>
        <Action type="WarnOthers">
          <Parameter key="alertRadius" value="10"/>
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>Ignore</Trigger>
        <Action type="Ignore">
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>Talk</Trigger>
        <Action type="Talk">
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>Approach</Trigger>
        <Action type="Approach">
        <Parameter key="approachSpeed" value="2"/>
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>Greet</Trigger>
        <Action type="Greet">
        <Parameter key="greetAnimation" value="Animations/NPCAnimations/Greet2"/>
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>GiveItem</Trigger>
        <Action type="GiveItem">
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>Flee</Trigger>
        <Action type="Flee">
        </Action>
      </TriggerAction>
    </TriggerActions>
    <LLMTriggers>
      <LLMTrigger>
        <Trigger>PlayerDetected</Trigger>
      </LLMTrigger>
      <LLMTrigger>
        <Trigger>UserInteraction</Trigger>
        <!-- Nessun CustomPrompt: userà il comportamento standard per le conversazioni -->
      </LLMTrigger>
    </LLMTriggers>
  </NPC>
  <NPC id="npc_002">
    <Name>Goruk</Name>
    <Backstory>Goruk is a wandering warrior, known for his strength and his bravery in battle.</Backstory>
    <Personality>Impulsive, loyal, and determined.</Personality>
    <InteractText>Talk</InteractText>
    <detectionRadius>0</detectionRadius>
    <detectionAngle>0</detectionAngle>
    <TriggerActions>
      <TriggerAction>
        <Trigger>Talk</Trigger>
        <Action type="Talk">
        </Action>
      </TriggerAction>
      <TriggerAction>
        <Trigger>WarnedByOthers</Trigger>
        <Action type="BeCautious">
          <Parameter key="cautiousDistance" value="10"/>
        </Action>
      </TriggerAction>
    </TriggerActions>
    <LLMTriggers>
      <LLMTrigger>
        <Trigger>UserInteraction</Trigger>
        <!-- Nessun CustomPrompt: userà il comportamento standard -->
      </LLMTrigger>
    </LLMTriggers>
  </NPC>
</NPCs>