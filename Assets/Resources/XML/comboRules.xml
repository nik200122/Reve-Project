<?xml version="1.0" encoding="utf-8"?>
<ComboRules xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Combo>
      <!-- Ogni step definisce il tipo dello step, l'attacco di default e (opzionalmente) dei modificatori -->
      <AttackStep index="1">
        <stepType>StepOne</stepType>
        <DefaultAttack id="Attack1" />
        <modifiers>
          <StatModifier>
            <targetStat>Attack</targetStat>
            <value>1.0</value>
            <modifierType>Multiplicative</modifierType>
          </StatModifier>
        </modifiers>
      </AttackStep>
      <AttackStep index="2">
        <stepType>StepTwo</stepType>
        <DefaultAttack id="Attack2" />
        <modifiers>
          <StatModifier>
            <targetStat>Attack</targetStat>
            <value>1.2</value>
            <modifierType>Multiplicative</modifierType>
          </StatModifier>
        </modifiers>
      </AttackStep>
      <AttackStep index="3">
        <stepType>StepThree</stepType>
        <DefaultAttack id="Attack3" />
        <modifiers>
          <StatModifier>
            <targetStat>Attack</targetStat>
            <value>1.5</value>
            <modifierType>Multiplicative</modifierType>
          </StatModifier>
        </modifiers>
      </AttackStep>
  </Combo>
</ComboRules>
