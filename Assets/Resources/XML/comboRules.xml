<?xml version="1.0" encoding="utf-8"?>
<ComboRules xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Combo>
      <!-- Ogni step definisce l'elenco degli attacchi che il player può scegliere -->
      <AttackStep index="1">
        <AllowedAttacks>
          <AttackRef id="Attack1" />
        </AllowedAttacks>
        <!-- Modifier specifici per lo step (opzionale) -->
        <modifiers>
          <PlayerModifier>
            <targetStat>Attack</targetStat>
            <value>1.0</value>
            <modifierType>Multiplicative</modifierType>
          </PlayerModifier>
        </modifiers>
      </AttackStep>
      <AttackStep index="2">
        <AllowedAttacks>
          <AttackRef id="Attack2" />
        </AllowedAttacks>
        <modifiers>
          <PlayerModifier>
            <targetStat>Attack</targetStat>
            <value>1.2</value>
            <modifierType>Multiplicative</modifierType>
          </PlayerModifier>
        </modifiers>
      </AttackStep>
      <AttackStep index="3">
        <AllowedAttacks>
          <AttackRef id="Attack3" />
          <AttackRef id="Attack4" />
        </AllowedAttacks>
        <modifiers>
          <PlayerModifier>
            <targetStat>Attack</targetStat>
            <value>1.5</value>
            <modifierType>Multiplicative</modifierType>
          </PlayerModifier>
        </modifiers>
      </AttackStep>
    </Combo>
</ComboRules>
